{
  "case": "malformed-pull-draft-wrong-type",
  "forge": "github",
  "kind": "malformed",
  "covers": "wrong_type",
  "description": "The pull request reports draft as a string.",
  "policy": {
    "repository": {
      "name": "example/widgets",
      "base_branch": "main",
      "forge": "github"
    },
    "review": {
      "reviewer_id": 4242,
      "reviewer_login": "review-bot[bot]",
      "reviewer_type": "Bot",
      "required_checks": [
        "checks"
      ],
      "gate_context": "review",
      "carry_unchanged_diff": false
    },
    "paths": {
      "ordinary": [
        "README.md",
        "docs/**"
      ],
      "dependency_update_exemption": false
    }
  },
  "run": {
    "mode": "status",
    "apply": false,
    "event_head": null
  },
